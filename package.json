{
  "name": "clipelle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "INNGEST_DEV=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:check": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs check",
    "dev:jobs": "inngest-cli dev -u http://localhost:3001/api/inngest --no-discovery --poll-interval 43200",
    "test": "vitest run",
    "check:secrets": "node scripts/check-secrets.mjs",
    "stripe:setup": "tsx --env-file=.env.local scripts/stripe-setup.ts",
    "examples:upload": "node --env-file=.env.local scripts/upload-examples.mjs",
    "db:migrate:prod": "node --env-file=.env.prod node_modules/drizzle-kit/bin.cjs migrate",
    "examples:upload:prod": "node --env-file=.env.prod scripts/upload-examples.mjs",
    "heygen:webhook": "node scripts/heygen-webhook.mjs",
    "vercel:env": "node scripts/vercel-env.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fal-ai/client": "^1.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.24.0",
    "lucide-react": "^1.59.0",
    "marked": "^16.4.2",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "inngest-cli": "^1.46.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
