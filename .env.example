# Copy to .env.local and fill in. Never commit .env.local. Never paste keys in code or chat.
# All of these are read on the server only (src/lib/services, Stage 7+). None reach the browser.

# Step 2 — script and hook generation (Anthropic Console → API keys)
ANTHROPIC_API_KEY=

# Step 3 — product clip from a photo (fal.ai dashboard → Keys)
FAL_KEY=

# Step 4 — AI presenter (https://platform.heygen.com/api-keys). v3 API only.
HEYGEN_API_KEY=
# Secret returned once when registering a webhook endpoint (POST /v3/webhooks/endpoints)
HEYGEN_WEBHOOK_SECRET=

# Step 5 — final edit (Shotstack dashboard → API keys). SHOTSTACK_ENV is "stage" (sandbox) or "v1" (production).
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage

# Step 5 fallback — only if Shotstack falls short in Stage 7 tests
CREATOMATE_API_KEY=

# Stage 8 — database and storage (Supabase project, region Frankfurt). Dashboard → Connect for the two
# connection strings (fill in the database password), Settings → API Keys for the URL and the keys.
# Transaction pooler, port 6543: used by the app at runtime (serverless-friendly).
DATABASE_URL=
# Session pooler, port 5432: used only by `npm run db:migrate` (migrations need a real session).
DIRECT_DATABASE_URL=
# Project URL and publishable key (sb_publishable_…): safe for the browser, used for direct uploads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only, bypasses row-level security. Never in the browser.
SUPABASE_SECRET_KEY=
# Private storage bucket for uploads and results (created on first use). Default "clipelle" for a new
# installation; an environment that already has files keeps its old bucket name here (files do not move).
STORAGE_BUCKET=clipelle

# Stage 8 — background jobs (Inngest). Local: `npm run dev:jobs` starts the dev server on :8288 and
# the `dev` script sets INNGEST_DEV=1 so the app talks to it; no account needed. Production (step 11):
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Demo mode (default on): simulated projects in the browser, visible "Demo mode" label. Set to false to use
# the database, storage and the real workflows (requires the Supabase variables above and the job system).
NEXT_PUBLIC_DEMO_MODE=true

# Public base URL of this app, used to build webhook callback URLs (e.g. https://your-domain.com)
APP_BASE_URL=

# Orchestrator defaults (optional; agreed choices in docs/cost-quality.md §12). Look/voice ids are listed for free on /dev/heygen.
HEYGEN_DEFAULT_LOOK_ID=
HEYGEN_DEFAULT_VOICE_ID=
# avatar_iii (default and recommended: 30 s fits the $1.50 budget) or avatar_iv (natural motion, six times the list price)
HEYGEN_DEFAULT_ENGINE=avatar_iii
# 1080p (default, same price as 720p in the API rate card) or 720p
HEYGEN_DEFAULT_RESOLUTION=1080p
# Empty = date-based default: minimax_turbo (1080p) until 31 October 2026, kling_standard from 1 November.
# Other values: minimax (H3 Max 768p), kling (v3 Pro).
PRODUCT_CLIP_MODEL=
# Claude model for the ad-tone rewrite of subtitles (the script itself always uses claude-opus-5-5)
REWRITE_MODEL=claude-sonnet-5-5
AD_TARGET_SECONDS=30
AD_LANGUAGE=en

# Cost guard for every paid API call (dev test benches now, orchestrator later).
# A call above the per-action limit, or one that would push today's total over the daily limit, is refused.
MAX_COST_PER_ACTION_USD=1.50
# Budget per creative: what one click may cost in total (Workflow A per project, Workflow B per language
# version). The NEXT_PUBLIC_ copy only feeds the "over budget" message in the forms; the server value decides.
MAX_COST_PER_CREATIVE_USD=2.00
NEXT_PUBLIC_MAX_COST_PER_CREATIVE_USD=2.00

# ---- Accounts, site, credits and payments (added 21 October 2026) ----
# Supabase Auth uses the same project as the database: NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY above. In the dashboard: Authentication → URL configuration →
# Site URL = NEXT_PUBLIC_SITE_URL, Redirect URLs = <site>/auth/callback (and http://localhost:3001/auth/callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Example videos for the marketing site: empty = the public "examples" bucket of the storage project above
# (npm run examples:upload). Set a CDN base URL here to serve them from elsewhere.
NEXT_PUBLIC_EXAMPLES_BASE_URL=
# Google sign-in button (needs the Google provider in Supabase Auth). Default off.
NEXT_PUBLIC_AUTH_GOOGLE=false
# Per-account spending limits on top of the budget per creative (US dollars).
MAX_COST_PER_USER_PER_DAY_USD=10
MAX_COST_PER_USER_PER_MONTH_USD=100
# Free first ad: global cap per calendar day. 0 pauses free ads.
FREE_ADS_PER_DAY=10
# Stripe TEST mode only: a restricted key rk_test_… (recommended) or sk_test_…, and whsec_…. Live keys are refused until launch.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Managed Payments (Stripe as merchant of record: VAT/sales tax, fraud, disputes). Off unless "true".
# Also switch it on in the Stripe Dashboard (Settings → Managed Payments) and run `npm run stripe:setup`.
STRIPE_MANAGED_PAYMENTS=
# Product tax code for every Clipelle product (must be eligible for Managed Payments). Empty = txcd_10105002.
STRIPE_TAX_CODE=
# Stripe Tax on our own sales (only when Managed Payments is off). Off unless "true"; add a tax registration in Stripe first.
STRIPE_AUTOMATIC_TAX=
# "I agree to the Terms of Service" checkbox on Checkout. Off unless "true"; set the terms URL in the Stripe Dashboard first.
STRIPE_REQUIRE_TERMS=
# Outgoing e-mail for demo/contact requests (Resend HTTP API). Empty = log only.
RESEND_API_KEY=
# Sender address only (the display name "Clipelle" is added by src/lib/brand.ts), or "Name <address>".
EMAIL_FROM=
NOTIFY_EMAIL=
# Support address shown on the site and in mails. Empty = the support link stays hidden (no invented address).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Partner tracking (Reditus): the account-specific script URL from the Reditus settings page. Loaded only after cookie consent. Empty = nothing loads.
NEXT_PUBLIC_REDITUS_SCRIPT_SRC=
# Analytics: a provider script URL loaded only after cookie consent (optional site id as data-site). Empty = nothing loads.
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=
NEXT_PUBLIC_ANALYTICS_SITE_ID=
# Public API: requests per key per minute (default 60).
API_RATE_LIMIT_PER_MINUTE=60
# ---- Growth features (added 21 October 2026) ----
# Administrators: comma-separated e-mail addresses that may open /admin (read-only numbers, Retry and
# Cancel for stuck projects). Everyone else gets a 404. Empty = nobody.
ADMIN_EMAILS=
# Homepage live numbers: a number shows only from this count (default 50); below it a product fact shows.
PUBLIC_STATS_MIN=
# Incoming provider webhooks: HEYGEN_WEBHOOK_SECRET above is the secret of the endpoint registered on
# /dev/webhooks; fal.ai signs with public keys, Shotstack is verified through its API. Callback URLs
# are only attached to jobs when APP_BASE_URL is a public https URL; without it the jobs poll.

# Remove on-screen text before translating (Replicate, 26 Oct 2026). Without a token the option is refused with a plain message.
REPLICATE_API_TOKEN=
# Optional: another Replicate model for text removal, and the assumed GPU price per second (for the cost guard).
REPLICATE_TEXT_REMOVAL_MODEL=
REPLICATE_USD_PER_GPU_SECOND=
