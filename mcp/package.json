{
  "name": "clipelle-mcp",
  "version": "0.2.0",
  "description": "MCP server (stdio) that translates videos and reads projects through the Clipelle API.",
  "type": "module",
  "bin": {
    "clipelle-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "homepage": "https://www.clipelle.com/docs/mcp",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clipelle",
    "video",
    "translation",
    "ai"
  ]
}
