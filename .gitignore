# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables — secrets stay local, only .env.example is committed
# Every .env file (also .env.production and .env.prod) stays out of git; only the example is committed.
.env*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Testing / misc
/coverage
*.pem
.pnpm-debug.log*

# Local cost log and other runtime data
.reelay/

# Example videos for the marketing site live in storage (npm run examples:upload); local copies stay out of git
/public/examples/

# Built MCP server (npm run build in mcp/)
/mcp/dist/

# Customer material waiting to be imported (names, photos, permissions): keep it out of git;
# only the instructions and the two templates are tracked.
/content-inbox/*
!/content-inbox/README.md
!/content-inbox/reviews.md
!/content-inbox/brands.md
!/content-inbox/numbers.md
!/content-inbox/press.md
!/content-inbox/links.md
!/content-inbox/review-request.md
!/content-inbox/stories/
/content-inbox/stories/*
!/content-inbox/stories/_template/
/content-inbox/stories/_template/*
!/content-inbox/stories/_template/story.md
